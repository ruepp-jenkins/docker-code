# Cursor CLI — https://cursor.com/docs/cli/overview
#
# The binary is `cursor-agent`, so the wrapper keeps that name rather than shortening it: nothing
# called `cursor` exists on the host to collide with, and the longer name is the honest one.

AGENT_ID=cursor
AGENT_TITLE="Cursor CLI"
AGENT_BIN=cursor-agent
AGENT_WRAPPER=cursor-agent-docker
AGENT_HOSTNAME=cursor-cli

AGENT_YOLO_ARGS="--force"
AGENT_YOLO_SKIP="login logout status update mcp"
AGENT_PERMISSION_FLAGS="--force -f"

AGENT_ENV_VARS="CURSOR_API_KEY CURSOR_CONFIG_DIR"

AGENT_DOMAINS="cursor.com api.cursor.com api2.cursor.sh downloads.cursor.com"

# Cursor runs its models server-side; there is no endpoint to redirect at a local one.
AGENT_LOCAL_MODE=none
AGENT_NOTE="Cloud-only: Cursor has no local-model endpoint, so DOCKER_CODE_LOCAL has no effect here."
