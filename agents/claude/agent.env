# Claude Code — https://docs.claude.com/en/docs/claude-code
#
# See ai/adding-an-agent.md for what each key means. Only AGENT_ID, AGENT_BIN and AGENT_WRAPPER are
# required.

AGENT_ID=claude
AGENT_TITLE="Claude Code"
AGENT_BIN=claude
AGENT_WRAPPER=claude-docker
AGENT_HOSTNAME=claude-code

# Claude Code refuses this flag as root and skips that refusal inside a declared sandbox; the
# container's launch.sh handles that, so nothing extra belongs here.
AGENT_YOLO_ARGS="--dangerously-skip-permissions"
AGENT_YOLO_SKIP="agents auth auto-mode daemon doctor gateway import install mcp plugin plugins project setup-token update"
AGENT_PERMISSION_FLAGS="--dangerously-skip-permissions --permission-mode"

# Claude Code refuses to bypass permission checks as root and skips that refusal inside a recognized
# sandbox. When the host user is root the entrypoint has to keep the container on root too, so that a
# root-owned workspace stays writable — and this is the container the check is talking about.
AGENT_ROOT_ENV="IS_SANDBOX=1"

AGENT_ENV_VARS="ANTHROPIC_API_KEY ANTHROPIC_AUTH_TOKEN ANTHROPIC_BASE_URL CLAUDE_CODE_OAUTH_TOKEN \
CLAUDE_CODE_USE_BEDROCK CLAUDE_CODE_USE_VERTEX AWS_REGION AWS_PROFILE CLOUD_ML_REGION \
ANTHROPIC_VERTEX_PROJECT_ID ANTHROPIC_MODEL ANTHROPIC_SMALL_FAST_MODEL ANTHROPIC_DEFAULT_OPUS_MODEL \
CLAUDE_CODE_SUBAGENT_MODEL CLAUDE_CODE_EFFORT_LEVEL CLAUDE_CODE_MAX_OUTPUT_TOKENS MAX_THINKING_TOKENS \
DISABLE_AUTO_COMPACT CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC"

# From the network-access table in https://code.claude.com/docs/en/network-config.
#
# platform.claude.com carries the OAuth token exchange, refresh and revocation for *both* Console and
# claude.ai sign-ins, so a session without it fails the first-run connectivity check outright:
#     Failed to connect to platform.claude.com: Status 403
# claude.com serves the page that sign-in opens before it redirects to claude.ai, and mcp-proxy is
# what connectors from claude.ai route through — they are on by default for claude.ai accounts.
#
# statsig.anthropic.com is gone from the list: feature-flag fetches go to api.anthropic.com now, and
# the name is null-routed to 0.0.0.0, so resolving it only ever added a dead entry to the allowlist.
#
# The optional hosts are deliberately absent — the two Datadog intakes carry telemetry and error
# reports that CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC turns off anyway, and bridge.claudeusercontent
# and formulae.brew.sh belong to a Chrome extension and a Homebrew install that a container has
# neither of.
AGENT_DOMAINS="api.anthropic.com platform.claude.com claude.ai claude.com \
console.anthropic.com mcp-proxy.anthropic.com downloads.claude.ai code.claude.com \
storage.googleapis.com"

# Ollama has spoken the Anthropic Messages API natively since January 2026, so Claude Code can point
# straight at it without a translating gateway.
AGENT_LOCAL_MODE=ollama-anthropic
AGENT_LOCAL_ENV="ANTHROPIC_BASE_URL=%u;ANTHROPIC_AUTH_TOKEN=docker-code-local;ANTHROPIC_MODEL=%m;ANTHROPIC_SMALL_FAST_MODEL=%m"
