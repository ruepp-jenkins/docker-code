# Mistral Vibe — https://github.com/mistralai/mistral-vibe
#
# Zum Namen: Das Produkt, das "Mistral Code" heißt, ist ein IDE-Plugin für VS Code und JetBrains —
# nichts, was in einem Container läuft. Mistrals Terminal-Agent heißt "Vibe", kommt von PyPI als
# `mistral-vibe` und wird als `vibe` aufgerufen. Der Wrapper heißt trotzdem mistral-docker, damit er
# in `docker-code list` bei den anderen Anbietern steht; vibe-docker tut dasselbe.
#
# Das npm-Paket "mistral-code" ist NICHT von Mistral: eine einzelne Version 0.0.0 ohne Repository von
# einem Privatkonto. Es gehört nicht in ein Image, das einen Agent mit weitreichenden Rechten fährt.

AGENT_ID=mistral
AGENT_TITLE="Mistral Vibe"
AGENT_BIN=vibe
AGENT_WRAPPER=mistral-docker
AGENT_ALIASES="vibe-docker"
AGENT_HOSTNAME=mistral-vibe

AGENT_YOLO_ARGS="--yolo"
AGENT_YOLO_SKIP="mcp"
AGENT_PERMISSION_FLAGS="--yolo --auto-approve"

AGENT_ENV_VARS="MISTRAL_API_KEY VIBE_ACTIVE_MODEL VIBE_THEME"

# api.mistral.ai ist die Kontrollprobe und der Modell-Endpunkt; console.mistral.ai die Browser-
# Anmeldung, chat.mistral.ai der Kontoteil, experiments.mistral.services die Feature-Flags, ohne die
# der Start in eine Zeitüberschreitung läuft statt sofort weiterzugehen.
AGENT_DOMAINS="api.mistral.ai console.mistral.ai chat.mistral.ai experiments.mistral.services"

# Vibe kennt beliebige OpenAI-kompatible Provider — `llamacpp` ist bereits als Default eingebaut, das
# Feld heißt api_style. Die Provider- und Modell-Listen werden über den VIBE_-Environment-Layer
# gesetzt und nach `name` zusammengeführt, nicht ersetzt: Mistrals eigener Provider bleibt daneben
# bestehen, die Session wählt über VIBE_ACTIVE_MODEL nur das lokale Modell aus.
AGENT_LOCAL_MODE=openai-compat
AGENT_LOCAL_ENV='VIBE_PROVIDERS=[{"name":"dockercode","api_base":"%u/v1","api_key_env_var":"MISTRAL_API_KEY","api_style":"openai"}];VIBE_MODELS=[{"name":"%m","provider":"dockercode"}];VIBE_ACTIVE_MODEL=%m;MISTRAL_API_KEY=docker-code-local'
