# Mistral Vibe — https://github.com/mistralai/mistral-vibe
#
# On the name: the product called "Mistral Code" is an IDE plugin for VS Code and JetBrains, which is
# not something that runs in a container. Mistral's terminal agent is called "Vibe", comes from PyPI as
# `mistral-vibe` and is invoked as `vibe`. The wrapper is still mistral-docker so that it sits with the
# other vendors in `docker-code list`; vibe-docker does the same thing.
#
# The npm package "mistral-code" is NOT Mistral's: a single version 0.0.0 from a private account, with
# no repository behind it. It does not belong in an image that runs an agent with far-reaching rights.

AGENT_ID=mistral
AGENT_TITLE="Mistral Vibe"
AGENT_BIN=vibe
AGENT_WRAPPER=mistral-docker
AGENT_ALIASES="vibe-docker"
AGENT_HOSTNAME=mistral-vibe

AGENT_YOLO_ARGS="--yolo"
AGENT_YOLO_SKIP="mcp"
AGENT_PERMISSION_FLAGS="--yolo --auto-approve"

AGENT_ENV_VARS="MISTRAL_API_KEY VIBE_ACTIVE_MODEL VIBE_THEME"

# api.mistral.ai is both the positive control and the model endpoint; console.mistral.ai is the
# browser sign-in, chat.mistral.ai the account side, and experiments.mistral.services the feature
# flags — without which startup runs into a timeout instead of carrying straight on.
AGENT_DOMAINS="api.mistral.ai console.mistral.ai chat.mistral.ai experiments.mistral.services"

# Vibe takes any OpenAI-compatible provider — `llamacpp` is already built in as a default, and the
# field is called api_style. The provider and model lists are set through the VIBE_ environment layer
# and are merged by `name` rather than replaced: Mistral's own provider stays alongside, and the
# session only selects the local model through VIBE_ACTIVE_MODEL.
AGENT_LOCAL_MODE=openai-compat
AGENT_LOCAL_ENV='VIBE_PROVIDERS=[{"name":"dockercode","api_base":"%u/v1","api_key_env_var":"MISTRAL_API_KEY","api_style":"openai"}];VIBE_MODELS=[{"name":"%m","provider":"dockercode"}];VIBE_ACTIVE_MODEL=%m;MISTRAL_API_KEY=docker-code-local'
