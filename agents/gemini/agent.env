# Gemini CLI — https://github.com/google-gemini/gemini-cli

AGENT_ID=gemini
AGENT_TITLE="Gemini CLI"
AGENT_BIN=gemini
AGENT_WRAPPER=gemini-docker
AGENT_HOSTNAME=gemini-cli

# --skip-trust alongside --yolo: workspace trust is a second, separate gate, and without it a
# headless --yolo run still stops with "not running in a trusted directory". The container's only
# host access is the directory the user started it in, so trusting that one under YOLO is
# consistent. Without YOLO nothing is skipped; GEMINI_CLI_TRUST_WORKSPACE below is the way to opt in
# on its own.
AGENT_YOLO_ARGS="--yolo --skip-trust"
AGENT_YOLO_SKIP="mcp extensions"
AGENT_PERMISSION_FLAGS="--yolo -y --approval-mode"

AGENT_ENV_VARS="GEMINI_API_KEY GOOGLE_API_KEY GOOGLE_CLOUD_PROJECT GOOGLE_CLOUD_LOCATION \
GOOGLE_GENAI_USE_VERTEXAI GOOGLE_GEMINI_BASE_URL GEMINI_MODEL GEMINI_DEFAULT_AUTH_TYPE \
GEMINI_CLI_TRUST_WORKSPACE"

AGENT_DOMAINS="generativelanguage.googleapis.com oauth2.googleapis.com accounts.google.com \
cloudcode-pa.googleapis.com aiplatform.googleapis.com"

# Gemini CLI speaks only Google's own wire format, so a local model needs the LiteLLM gateway in
# front of Ollama. GOOGLE_GEMINI_BASE_URL is the @google/genai SDK's own redirect hook, which is why
# this works without patching the CLI: the SDK appends /v1beta/models/<model>:generateContent, and
# LiteLLM serves exactly that path from its own model list.
#
# The gateway's root, not its /gemini prefix — that one is a pass-through to Google AI Studio and
# would send the request to the internet rather than to Ollama.
# Headless runs take the auth method from settings, not from the environment, so a local session
# needs the API-key method selected somewhere. It points at a read-only file baked into the image
# (agents/gemini/local-settings.json) through the CLI's own system-settings hook, rather than writing
# into ~/.gemini: a user who signs in with Google for their cloud sessions keeps that choice
# untouched, and the override lasts exactly as long as the session that asked for it.
AGENT_LOCAL_MODE=litellm-gemini
AGENT_LOCAL_ENV="GOOGLE_GEMINI_BASE_URL=%u;GEMINI_API_KEY=docker-code-local;GEMINI_CLI_SYSTEM_SETTINGS_PATH=/opt/docker-code/gemini-local-settings.json"
AGENT_LOCAL_ARGS="--model %m"
