# GitHub Copilot CLI — https://github.com/github/copilot-cli

AGENT_ID=copilot
AGENT_TITLE="GitHub Copilot CLI"
AGENT_BIN=copilot
AGENT_WRAPPER=copilot-docker
AGENT_HOSTNAME=copilot-cli

# --allow-all-tools covers tool execution; --allow-all-paths and --allow-all-urls are the two extra
# gates that a container-as-sandbox makes redundant.
AGENT_YOLO_ARGS="--allow-all-tools --allow-all-paths --allow-all-urls"
AGENT_YOLO_SKIP="mcp help version"
AGENT_PERMISSION_FLAGS="--allow-all-tools --allow-all --yolo --allow-tool --deny-tool"

AGENT_ENV_VARS="GH_TOKEN GITHUB_TOKEN COPILOT_MODEL COPILOT_ALLOW_ALL"

# From https://docs.github.com/en/copilot/reference/allowlist-reference.
#
# The api.<plan>.githubcopilot.com hosts are the ones a signed-in subscriber actually talks to —
# api.githubcopilot.com alone serves nobody with a paid plan, and which of the three applies is a
# property of the account rather than of this container, so all three are listed. Wildcards are not an
# option: image/init-firewall.sh resolves these names for NET=restricted and `.githubcopilot.com`
# resolves to nothing.
#
# The telemetry hosts the same page lists are left out: collector.github.com and
# copilot-telemetry.githubusercontent.com are both null-routed to 0.0.0.0, so allowing them would only
# put dead entries in the allowlist.
AGENT_DOMAINS="api.githubcopilot.com api.individual.githubcopilot.com \
api.business.githubcopilot.com api.enterprise.githubcopilot.com \
api.github.com github.com copilot-proxy.githubusercontent.com \
origin-tracker.githubusercontent.com objects.githubusercontent.com"

# Remote control from GitHub web and mobile. GitHub's allowlist reference names no host of its own for
# it; should a filtered session fail to connect, DOCKER_CODE_ALLOW_DOMAINS is where the missing one
# goes.
AGENT_REMOTE_ARGS="--remote"

# Copilot only talks to GitHub's own inference endpoints.
AGENT_LOCAL_MODE=none
AGENT_NOTE="Cloud-only: models are served by GitHub, so DOCKER_CODE_LOCAL has no effect here."
