# GitHub Copilot CLI — https://github.com/github/copilot-cli

AGENT_ID=copilot
AGENT_TITLE="GitHub Copilot CLI"
AGENT_BIN=copilot
AGENT_WRAPPER=copilot-docker
AGENT_HOSTNAME=copilot-cli

# --allow-all-tools covers tool execution; --allow-all-paths and --allow-all-urls are the two extra
# gates that a container-as-sandbox makes redundant.
AGENT_YOLO_ARGS="--allow-all-tools --allow-all-paths --allow-all-urls"
AGENT_YOLO_SKIP="mcp help version"
AGENT_PERMISSION_FLAGS="--allow-all-tools --allow-all --yolo --allow-tool --deny-tool"

AGENT_ENV_VARS="GH_TOKEN GITHUB_TOKEN COPILOT_MODEL COPILOT_ALLOW_ALL"

AGENT_DOMAINS="api.githubcopilot.com api.github.com github.com copilot-proxy.githubusercontent.com \
objects.githubusercontent.com"

# Copilot only talks to GitHub's own inference endpoints.
AGENT_LOCAL_MODE=none
AGENT_NOTE="Cloud-only: models are served by GitHub, so DOCKER_CODE_LOCAL has no effect here."
