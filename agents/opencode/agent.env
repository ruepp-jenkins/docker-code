# OpenCode — https://opencode.ai/docs/

AGENT_ID=opencode
AGENT_TITLE="OpenCode"
AGENT_BIN=opencode
AGENT_WRAPPER=opencode-docker
AGENT_HOSTNAME=opencode

# OpenCode has no bypass flag: permissions are a config concern, not a CLI one. YOLO for this agent
# is therefore the seeded permission block in agents/opencode/defaults/opencode.json, which the
# entrypoint only writes when the user has none of their own.
AGENT_YOLO_ARGS=""
AGENT_NOTE="Permissions live in the permission block of ~/.config/opencode/opencode.json, not in a flag, so DOCKER_CODE_YOLO has nothing to pass."

AGENT_ENV_VARS="ANTHROPIC_API_KEY OPENAI_API_KEY OPENROUTER_API_KEY GROQ_API_KEY \
GOOGLE_GENERATIVE_AI_API_KEY OPENCODE_CONFIG OPENCODE_CONFIG_DIR OPENCODE_DISABLE_AUTOUPDATE"

AGENT_DOMAINS="opencode.ai api.opencode.ai models.dev api.anthropic.com api.openai.com openrouter.ai"

# OpenCode only offers models a provider block actually declares, and the session's model is not
# known when the image is built. OPENCODE_CONFIG_CONTENT is its own hook for runtime overrides, so
# the model is declared for the length of the session and merges with the provider block seeded in
# ~/.config/opencode/opencode.json — which stays the place to add local models permanently.
AGENT_LOCAL_MODE=openai-compat
AGENT_LOCAL_ENV='OPENCODE_CONFIG_CONTENT={"provider":{"dockercode":{"npm":"@ai-sdk/openai-compatible","name":"docker-code local models","options":{"baseURL":"%u/v1"},"models":{"%m":{"name":"%m"}}}}}'
AGENT_LOCAL_ARGS="--model dockercode/%m"
