# Kiro CLI — https://kiro.dev/docs/cli/
#
# This is the tool that used to be the Amazon Q Developer CLI: AWS closed Q Developer to new signups
# in May 2026 and moved the terminal agent to Kiro. The archive is still called kirocli and it ships
# `q` and `qchat` shims, but the command is kiro-cli.

AGENT_ID=kiro
AGENT_TITLE="Kiro CLI"
AGENT_BIN=kiro-cli
AGENT_WRAPPER=kiro-docker
AGENT_HOSTNAME=kiro-cli

# `chat` is part of the YOLO arguments, not a leftover: --trust-all-tools belongs to the chat
# subcommand, and the top-level parser rejects it outright. Bare `kiro-cli` opens chat anyway, so
# naming the subcommand is what lets the flag reach it — and it is also what makes
# `kiro-docker "fix the failing test"` work, which the bare form refuses as an unknown subcommand.
AGENT_YOLO_ARGS="chat --trust-all-tools"

# Every other subcommand, plus `chat` itself, because the arguments above already name it. This list
# carries more weight here than for the other agents: an unlisted subcommand would not merely
# collect a stray flag, it would be swallowed as the chat prompt — `kiro-cli chat --trust-all-tools
# mcp list` asks the model about "mcp list" instead of listing MCP servers. `kiro-cli --help-all`
# prints the full set.
AGENT_YOLO_SKIP="chat acp agent crew dashboard debug diagnostic doctor help init inline integrations \
issue launch login logout mcp profile quit restart settings setup theme translate update user whoami"

AGENT_PERMISSION_FLAGS="--trust-all-tools -a --trust-tools"

# KIRO_API_KEY is the headless path and the only sign-in that needs no browser. The interactive one
# tries to open a browser that does not exist in a container and then prints the way out itself:
# `kiro-docker login --use-device-flow`. AWS_REGION and AWS_PROFILE matter only for accounts that
# authenticate through IAM Identity Center.
AGENT_ENV_VARS="KIRO_API_KEY AWS_REGION AWS_PROFILE"

# Kiro spreads itself over more hosts than the other agents: runtime.* serves the models,
# q.<region>.amazonaws.com is the older endpoint it still calls, management.* the account side,
# app.kiro.dev the sign-in portal, and the auth host issues the tokens. oidc and cognito-identity
# cover Identity Center and social sign-in; an Identity Center in another region needs its own
# DOCKER_CODE_ALLOW_DOMAINS entry, because those names contain the directory alias.
#
# Telemetry is in the list on purpose: an unreachable telemetry endpoint costs a timeout at every
# start rather than an error, and `kiro-cli settings telemetry.enabled false` is the way to turn it
# off. prod.download.desktop.kiro.dev is deliberately absent — the updater is disabled in the image,
# and a new image is the update path.
AGENT_DOMAINS="runtime.us-east-1.kiro.dev runtime.eu-central-1.kiro.dev q.us-east-1.amazonaws.com \
q.eu-central-1.amazonaws.com management.us-east-1.kiro.dev management.eu-central-1.kiro.dev \
app.kiro.dev assets.app.kiro.dev prod.us-east-1.auth.desktop.kiro.dev \
oidc.us-east-1.amazonaws.com cognito-identity.us-east-1.amazonaws.com \
prod.us-east-1.telemetry.desktop.kiro.dev telemetry.us-east-1.kiro.dev telemetry.eu-central-1.kiro.dev"

# The models are Kiro's own, served by AWS. The settings do expose endpoint overrides
# (api.q.service and friends), but they expect AWS service protocols, not an OpenAI-compatible URL,
# so there is nothing here for Ollama to answer.
AGENT_LOCAL_MODE=none
AGENT_NOTE="Cloud-only: Kiro serves its models from AWS, so DOCKER_CODE_LOCAL has no effect here."
