# Qwen Code — https://github.com/QwenLM/qwen-code
#
# A Gemini CLI fork, so the flags line up; the provider side is plain OpenAI-compatible, which makes
# this the least fussy of the seven to point at a local model.

AGENT_ID=qwen
AGENT_TITLE="Qwen Code"
AGENT_BIN=qwen
AGENT_WRAPPER=qwen-docker
AGENT_HOSTNAME=qwen-code

AGENT_YOLO_ARGS="--yolo"
AGENT_YOLO_SKIP="mcp extensions"
AGENT_PERMISSION_FLAGS="--yolo -y --approval-mode"

AGENT_ENV_VARS="OPENAI_API_KEY OPENAI_BASE_URL OPENAI_MODEL DASHSCOPE_API_KEY"

AGENT_DOMAINS="dashscope.aliyuncs.com dashscope-intl.aliyuncs.com portal.qwen.ai chat.qwen.ai api.openai.com"

AGENT_LOCAL_MODE=openai-compat
AGENT_LOCAL_ENV="OPENAI_BASE_URL=%u/v1;OPENAI_API_KEY=docker-code-local;OPENAI_MODEL=%m"
