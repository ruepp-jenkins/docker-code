# OpenAI Codex CLI — https://github.com/openai/codex

AGENT_ID=codex
AGENT_TITLE="OpenAI Codex CLI"
AGENT_BIN=codex
AGENT_WRAPPER=codex-docker
AGENT_HOSTNAME=codex-cli

# --full-auto is deprecated and still sandboxes the network; this is the flag that actually means
# "the container is the sandbox", which here it is.
AGENT_YOLO_ARGS="--dangerously-bypass-approvals-and-sandbox"
AGENT_YOLO_SKIP="login logout mcp apply completion resume exec-server app-server cloud"
AGENT_PERMISSION_FLAGS="--dangerously-bypass-approvals-and-sandbox --full-auto --ask-for-approval -a --sandbox -s"

AGENT_ENV_VARS="OPENAI_API_KEY OPENAI_BASE_URL CODEX_API_KEY"

AGENT_DOMAINS="api.openai.com auth.openai.com chatgpt.com platform.openai.com"

# Codex reaches a local server through a [model_providers.*] block; agents/codex/defaults seeds one
# pointing at localhost, and the container's port bridge makes localhost real. Upstream's built-in
# --oss path is not used because it ignores base_url (openai/codex#8240).
AGENT_LOCAL_MODE=openai-compat
AGENT_LOCAL_ENV="OPENAI_BASE_URL=%u/v1;OPENAI_API_KEY=docker-code-local"
AGENT_LOCAL_ARGS="--config model_provider=dockercode --model %m"
