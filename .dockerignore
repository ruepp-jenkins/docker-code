# The build context is the repository root for every image, so keep it small and predictable.
.git
.gitignore
test-results
build-metadata-*.json
digest-*.txt

# The docs are excluded except the ones tests/lint.bats and tests/pipeline.bats read back.
*.md
!README.md
!AGENTS.md
!CLAUDE.md
!GEMINI.md
!QWEN.md
!ai/
!ai/*.md
!docs/
!docs/*.md
